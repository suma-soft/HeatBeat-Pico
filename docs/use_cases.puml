@startuml HeatBeat_Use_Cases
!theme plain
skinparam backgroundColor #FAFAFA
skinparam actor {
    BackgroundColor #E8F4FD
    BorderColor #2196F3
}
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #666666
    BorderThickness 1.5
}
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #999999
}

title Diagram Przypadków Użycia - System Termostatu HeatBeat

' Aktorzy
actor "Użytkownik" as User
actor "System Backendu" as Backend
actor "Czujnik BME280" as Sensor
actor "System Grzewczy" as Heating

' Pakiety funkcjonalności
package "Interfejs Użytkownika" {
    usecase "Wyświetlanie temperatury\ni wilgotności" as UC1
    usecase "Ustawianie temperatury\ndocelowej" as UC2
    usecase "Odblokowywanie ekranu\n(3 dotknięcia)" as UC3
    usecase "Wyświetlanie statusu\nsystemu" as UC4
    usecase "Obsługa powiadomień" as UC5
}

package "Zarządzanie Temperaturą" {
    usecase "Odczytywanie danych\nz czujnika" as UC6
    usecase "Kontrola przekaźnika\ngrzewczego" as UC7
    usecase "Wykrywanie otwartego\nokna" as UC8
    usecase "Alarm otwartego\nokna" as UC9
}

package "Komunikacja Sieciowa" {
    usecase "Łączenie z WiFi" as UC10
    usecase "Wysyłanie danych\ntelemetrycznych" as UC11
    usecase "Pobieranie ustawień\nz serwera" as UC12
    usecase "Aktualizacja ustawień\nna serwerze" as UC13
    usecase "Synchronizacja\nz backendem" as UC14
}

package "Diagnostyka i Monitoring" {
    usecase "Diagnostyka modułu\nWiFi CYW43" as UC15
    usecase "Monitoring pamięci\nRAM" as UC16
    usecase "Logowanie zdarzeń\nsystemowych" as UC17
    usecase "Obsługa błędów\nkomunikacji" as UC18
}

package "Bezpieczeństwo" {
    usecase "Zabezpieczenie przed\nnakładającymi się requestami" as UC19
    usecase "Timeout połączeń\nHTTP" as UC20
    usecase "Lokalne nadpisanie\nustawień" as UC21
}

' Relacje User
User --> UC1 : "Odczytuje"
User --> UC2 : "Ustawia"
User --> UC3 : "Odblokowuje"
User --> UC4 : "Monitoruje"
User --> UC5 : "Otrzymuje"

' Relacje Backend
Backend --> UC11 : "Odbiera dane"
Backend --> UC12 : "Dostarcza ustawienia"
Backend --> UC13 : "Przyjmuje aktualizacje"
Backend --> UC14 : "Synchronizuje"

' Relacje Sensor
Sensor --> UC6 : "Dostarcza pomiary"
UC6 --> UC1 : "<<include>>"
UC6 --> UC8 : "<<include>>"

' Relacje Heating
UC7 --> Heating : "Steruje"

' Relacje wewnętrzne - Include
UC2 --> UC13 : "<<include>>"
UC2 --> UC21 : "<<include>>"
UC8 --> UC9 : "<<include>>"
UC10 --> UC11 : "<<include>>"
UC10 --> UC12 : "<<include>>"
UC10 --> UC13 : "<<include>>"
UC11 --> UC19 : "<<include>>"
UC12 --> UC19 : "<<include>>"
UC13 --> UC19 : "<<include>>"
UC11 --> UC20 : "<<include>>"
UC12 --> UC20 : "<<include>>"
UC13 --> UC20 : "<<include>>"

' Relacje wewnętrzne - Extend
UC15 --> UC10 : "<<extend>>"
UC16 --> UC17 : "<<extend>>"
UC18 --> UC17 : "<<extend>>"
UC9 --> UC5 : "<<extend>>"

' Dodatkowe relacje systemowe
UC6 --> UC7 : "Wyzwala kontrolę"
UC8 --> UC17 : "Loguje wykrycie"
UC14 --> UC4 : "Aktualizuje status"

note right of UC8
  Wykrywa spadek temperatury
  ≥2°C w ciągu 2 minut
end note

note right of UC9
  Aktywuje sygnał dźwiękowy
  przez 10 minut lub do
  odblokowania ekranu
end note

note right of UC19
  Mutex http_in_progress
  zapobiega równoczesnym
  requestom HTTP
end note

note right of UC20
  Emergency timeout 1M iteracji
  Progress timeout 2-4s
end note

note bottom of UC21
  Lokalne zmiany mają
  priorytet przez określony
  czas po wprowadzeniu
end note

@enduml